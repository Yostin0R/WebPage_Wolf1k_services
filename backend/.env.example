# ---------- Server ----------
NODE_ENV=development
PORT=3000

# Comma-separated list of origins allowed to call the API (the frontend URL).
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 when running directly,
# 1 behind Nginx / a load balancer). Needed for correct client IPs in rate limiting.
TRUST_PROXY=0

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=wolf1k
DB_PASSWORD=change_me
DB_NAME=wolf1k
DB_CONNECTION_LIMIT=10

# ---------- Rate limiting ----------
# General limit for every endpoint (requests per window per IP).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
# Strict limit for POST /reviews.
FORM_RATE_LIMIT_WINDOW_MINUTES=60
FORM_RATE_LIMIT_MAX=5
